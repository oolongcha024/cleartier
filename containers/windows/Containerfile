ARG NODE_IMAGE=docker.io/library/node:24.21.0-bookworm-slim@sha256:713cfbf4a0ac19f40e1bb9919893e126b74a5c8cf5d0623c9f89515c8f74c6fa
ARG RUST_IMAGE=docker.io/library/rust:1.96.0-trixie@sha256:477cee146d00e0dd888ce66a279ff78ccfd6fdf265e83414a4264652643c881a

FROM ${NODE_IMAGE} AS node
FROM ${RUST_IMAGE}

COPY --from=node /usr/local/ /usr/local/

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates clang lld llvm nsis python3 python3-venv \
        cmake ninja-build pkg-config file unzip \
    && test -f /usr/share/nsis/Include/Win/RestartManager.nsh \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@11.26.0 \
    && python3 -m venv /opt/cargo-xwin \
    && /opt/cargo-xwin/bin/pip install --no-cache-dir cargo-xwin==0.23.1 \
    && rustup target add x86_64-pc-windows-msvc

ENV PATH="/opt/cargo-xwin/bin:${PATH}"

WORKDIR /workspace
COPY build.sh /usr/local/bin/cleartier-build-windows
ENTRYPOINT ["bash", "/usr/local/bin/cleartier-build-windows"]
