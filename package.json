{
  "name": "cleartier",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "基于 EasyTier 的跨平台本地桌面客户端",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm version:check && vite",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "format": "prettier . --write && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier . --check && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "theme:generate": "node scripts/generate-theme.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "pnpm version:check && pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "build:windows:exe": "node scripts/build-windows.mjs exe",
    "build:windows:nsis": "node scripts/build-windows.mjs nsis",
    "build:windows:all": "node scripts/build-windows.mjs all",
    "test:browser": "node scripts/test-browser.mjs",
    "version:start": "node scripts/version.mjs start",
    "version:next": "node scripts/version.mjs next",
    "version:promote": "node scripts/version.mjs promote",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "i18next": "27.0.0",
    "material-symbols": "0.48.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0",
    "react-router": "8.5.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "semver": "7.8.6",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
