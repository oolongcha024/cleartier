{
  "name": "cleartier",
  "version": "0.1.0",
  "private": true,
  "description": "基于 EasyTier 的跨平台本地桌面客户端",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "theme:generate": "node scripts/generate-theme.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:windows": "node scripts/build-windows.mjs",
    "build:windows:exe": "node scripts/build-windows.mjs exe",
    "build:windows:nsis": "node scripts/build-windows.mjs nsis",
    "build:windows:all": "node scripts/build-windows.mjs all"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@material/material-color-utilities": "0.4.0",
    "@tauri-apps/api": "2.12.4",
    "i18next": "27.0.0",
    "material-symbols": "0.48.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0",
    "react-router": "8.5.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
